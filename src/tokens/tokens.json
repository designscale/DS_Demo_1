{
  "$description": "Design tokens pulled from Figma variables (file: 01 - Step 1: Hand-made Figma to Code). Collections and modes mirror Figma. Run `npm run tokens` to regenerate tokens.css.",
  "color-primitives": {
    "brand": {
      "100": "#ffede5",
      "200": "#ffccb8",
      "300": "#ffa585",
      "400": "#ff8556",
      "500": "#ff6330",
      "600": "#e54d1a",
      "700": "#b33b14",
      "800": "#80290d",
      "900": "#4d1707"
    },
    "neutral": {
      "000": "#ffffff",
      "100": "#f7f7f7",
      "200": "#e8e8e8",
      "300": "#d1d1d1",
      "400": "#a0a0a0",
      "500": "#737373",
      "600": "#525252",
      "700": "#3d3d3d",
      "800": "#2c2c2c",
      "900": "#161616",
      "999": "#000000"
    }
  },
  "color": {
    "$modes": ["light", "dark"],
    "action": {
      "primary": {
        "default": { "light": "neutral.800", "dark": "neutral.100" },
        "disabled": { "light": "neutral.200", "dark": "neutral.700" },
        "hover": { "light": "neutral.700", "dark": "neutral.200" },
        "pressed": { "light": "neutral.900", "dark": "neutral.300" },
        "text": { "light": "neutral.000", "dark": "neutral.900" }
      },
      "secondary": {
        "border": { "light": "neutral.300", "dark": "neutral.700" },
        "default": { "light": "neutral.000", "dark": "neutral.900" },
        "hover": { "light": "neutral.100", "dark": "neutral.800" },
        "pressed": { "light": "neutral.200", "dark": "neutral.700" },
        "text": { "light": "neutral.900", "dark": "neutral.100" }
      }
    },
    "border": {
      "accent": { "light": "brand.500", "dark": "brand.500" },
      "default": { "light": "neutral.300", "dark": "neutral.700" },
      "focus": { "light": "brand.500", "dark": "brand.400" },
      "strong": { "light": "neutral.900", "dark": "neutral.400" }
    },
    "surface": {
      "accent-subtle": { "light": "brand.100", "dark": "brand.900" },
      "default": { "light": "neutral.000", "dark": "neutral.900" },
      "inverse": { "light": "neutral.900", "dark": "neutral.100" },
      "raised": { "light": "neutral.100", "dark": "neutral.800" }
    },
    "text": {
      "accent": { "light": "brand.500", "dark": "brand.500" },
      "default": { "light": "neutral.900", "dark": "brand.100" },
      "disabled": { "light": "neutral.400", "dark": "neutral.600" },
      "inverse": { "light": "neutral.000", "dark": "neutral.900" },
      "muted": { "light": "neutral.600", "dark": "neutral.400" }
    }
  },
  "space": {
    "100": 4,
    "200": 8,
    "300": 12,
    "400": 16,
    "500": 24,
    "600": 32,
    "700": 48,
    "800": 64,
    "900": 80
  },
  "radius": {
    "md": 8
  },
  "text-primitives": {
    "$modes": { "sm": "< 800px", "md": ">= 800px", "lg": ">= 1280px" },
    "font-family": { "sans": "Poppins" },
    "font-weight": { "regular": 400, "semibold": 600, "bold": 700 },
    "font-size": {
      "100": { "sm": 16, "md": 16, "lg": 16 },
      "200": { "sm": 16, "md": 24, "lg": 24 },
      "300": { "sm": 32, "md": 32, "lg": 40 },
      "400": { "sm": 32, "md": 40, "lg": 48 },
      "500": { "sm": 40, "md": 56, "lg": 56 },
      "600": { "sm": 48, "md": 64, "lg": 80 }
    }
  },
  "font": {
    "$description": "Figma text styles. letterSpacing is in percent of font size, as in Figma.",
    "display/md": { "size": "600", "weight": "bold", "lineHeight": 1.2, "letterSpacing": -2 },
    "headline/lg": { "size": "400", "weight": "bold", "lineHeight": 1.45, "letterSpacing": -2 },
    "headline/md": { "size": "300", "weight": "bold", "lineHeight": 1.25, "letterSpacing": -2 },
    "headline/sm": { "size": "200", "weight": "bold", "lineHeight": 1.45, "letterSpacing": -0.5 },
    "caption/md": { "size": "200", "weight": "regular", "lineHeight": 1.45, "letterSpacing": -0.5 },
    "body/md/default": { "size": "100", "weight": "regular", "lineHeight": 1.7, "letterSpacing": -0.5 },
    "body/md/strong": { "size": "100", "weight": "bold", "lineHeight": 1.7, "letterSpacing": -0.5 },
    "link/inline": { "size": "100", "weight": "regular", "lineHeight": 1.7, "letterSpacing": -0.5 },
    "link/md": { "size": "100", "weight": "bold", "lineHeight": 1.7, "letterSpacing": -2 },
    "navigation/md": { "size": "100", "weight": "semibold", "lineHeight": "normal", "letterSpacing": 0 },
    "button/md": { "size": "100", "weight": "semibold", "lineHeight": "normal", "letterSpacing": 0 }
  }
}
